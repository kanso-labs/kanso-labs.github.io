{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "ignorePatterns": [
    ".claude/worktrees",
    ".react-router",
    "LICENSE.md",
    "build"
  ],
  "printWidth": 80,
  "proseWrap": "always",
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": false,
  "trailingComma": "all"
}
